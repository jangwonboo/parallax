{
  "name": "parallax",
  "productName": "Parallax",
  "version": "0.1.0",
  "description": "영문 문서를 좌우 대역으로 읽는 번역 리더",
  "author": "jangwonboo",
  "main": "dist/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild": "node scripts/rebuild-native.mjs",
    "postinstall": "node scripts/rebuild-native.mjs",
    "dist": "npm run build && node scripts/clean-release.mjs && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.5.0",
    "katex": "^0.18.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "fo.parallax.reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      "resources/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "fileAssociations": [
      {
        "ext": "parallax",
        "name": "Parallax 문서",
        "role": "Editor"
      }
    ]
  }
}
